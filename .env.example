# Copie para .env e preencha. Nunca commitar o .env.

# PostgreSQL / PostGIS (valores do compose.yaml, só dev local)
DB_NAME=motok
DB_URL=jdbc:postgresql://localhost:5432/${DB_NAME}
DB_USER=postgres
DB_PASSWORD=postgres

# Feature flags (v1 funciona com ambas desligadas)
FEATURE_KAFKA_OCUPACAO=false
FEATURE_CHATBOT=false

# Kafka (somente se FEATURE_KAFKA_OCUPACAO=true)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# AWS (Amazon Location Service, Bedrock)
AWS_REGION=
LOCATION_PLACE_INDEX=
BEDROCK_MODEL_ID=
